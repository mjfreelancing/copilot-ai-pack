{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sync-global-copilot-assets-dryrun-with-options",
      "type": "shell",
      "command": ".\\.github\\scripts\\sync-global-copilot-assets.ps1 -DryRun -AssetProfile \"${input:copilotAssetsProfile}\" -AssetsRepoPath \"${input:copilotAssetsRepoPath}\"",
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "group": {
        "kind": "build",
        "isDefault": false,
      },
      "problemMatcher": [],
    },
    {
      "label": "sync-global-copilot-assets-with-options",
      "type": "shell",
      "command": ".\\.github\\scripts\\sync-global-copilot-assets.ps1 -AssetProfile \"${input:copilotAssetsProfile}\" -AssetsRepoPath \"${input:copilotAssetsRepoPath}\"",
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "group": {
        "kind": "build",
        "isDefault": false,
      },
      "problemMatcher": [],
    },
  ],
  "inputs": [
    {
      "id": "copilotAssetsProfile",
      "type": "pickString",
      "description": "Select the global Copilot asset profile to sync",
      "options": [
        "fullstack-react-aspnet-postgres",
        "aspnetcore-api-postgres",
        "react-typescript-client",
        "dotnet-csharp-tests",
      ],
      "default": "fullstack-react-aspnet-postgres",
    },
    {
      "id": "copilotAssetsRepoPath",
      "type": "promptString",
      "description": "Path to mjf-copilot-assets repo",
      "default": "${workspaceFolder}/../mjf-copilot-assets",
    },
  ],
}
